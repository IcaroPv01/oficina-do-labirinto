# Bind only to the local machine. Keep this when using cloudflared on the same PC.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8787
STUDIO_DATABASE_PATH=./data/studio.sqlite
# Optional. The server discovers this checkout automatically in normal use.
# STUDIO_PROJECT_ROOT=..

# Exact browser origins, comma-separated. Wildcards and paths are rejected.
# Replace only if the published Studio UI moves to another origin.
STUDIO_CORS_ORIGINS=https://icaropv01.github.io

# Safe production defaults for the Pages UI + HTTPS tunnel.
# Local HTTP development may use false + lax while STUDIO_HOST stays loopback.
STUDIO_COOKIE_SECURE=true
STUDIO_COOKIE_SAME_SITE=none
STUDIO_SESSION_TTL_HOURS=168
STUDIO_INVITE_TTL_HOURS=24

# Local-only shortcut. Keep false whenever a tunnel is active.
STUDIO_DEV_AUTH_ENABLED=false

# The key stays only on this server. Never prefix it with VITE_ or commit .env.
VERBOO_API_KEY=
VERBOO_BASE_URL=https://code.verboo.ai/router/v1
VERBOO_DEFAULT_MODEL=pro/deepseek-v4-flash
VERBOO_TIMEOUT_MS=45000

# Technical safety limits protect the old PC even when provider tokens are free.
STUDIO_MAX_JSON_BYTES=262144
STUDIO_MAX_SNAPSHOT_BYTES=2097152
STUDIO_MAX_WS_BYTES=65536
STUDIO_MAX_CHAT_CHARS=8000
STUDIO_MAX_AI_CHARS=24000
STUDIO_MAX_AI_RESPONSE_BYTES=2097152
